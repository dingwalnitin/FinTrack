<?xml version="1.0" encoding="utf-8"?>
<!--
  FinTrack launcher icon foreground.
  A clean white "trending-up" arrow + arrowhead, designed inside the 66dp
  inner safe zone of a 108dp adaptive icon (translated to keep the
  artwork centered after launchers apply their mask).

  The full drawable canvas is 108x108dp, but the visible/safe inner area
  is the central 66x66dp (i.e. x in [21, 87], y in [21, 87]). We inset
  the path coordinates by 4dp on each side so the stroke width never
  bleeds into the masked region.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!--
      Two paths so the arrowhead reads as a corner kink, not a straight
      continuation. All strokes are white, round-capped, round-joined
      for the soft, modern look seen in the preview.
    -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="9"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M30,76 L50,54 L62,66 L86,40" />
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="9"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M68,40 L86,40 L86,58" />
</vector>
